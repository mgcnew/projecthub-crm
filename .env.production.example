# Variáveis do front em PRODUÇÃO (Vercel → Project → Settings → Environment Variables → Production).
# Apenas valores PÚBLICOS entram no bundle. NUNCA coloque service_role, sb_secret_*, senha do banco ou
# tokens aqui: o CI (`npm run check:bundle`) falha se um segredo privilegiado aparecer no dist/.

# URL do projeto Supabase hospedado (Settings → API → Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável (Settings → API Keys → Publishable key, "sb_publishable_…")
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI
